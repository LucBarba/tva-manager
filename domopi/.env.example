# =============================================================================
# DomoPi - Configuration d'environnement
# Copier ce fichier vers `.env` puis adapter les valeurs.
# =============================================================================

# --- Application ---
DOMOPI_APP_NAME=DomoPi
DOMOPI_ENVIRONMENT=production          # production | development | test
DOMOPI_HOST=0.0.0.0
DOMOPI_PORT=8000
DOMOPI_DEBUG=false

# --- Securite ---
# Generer avec : python -c "import secrets; print(secrets.token_hex(32))"
DOMOPI_SECRET_KEY=change-me-please-64-hex-chars
DOMOPI_JWT_ALGORITHM=HS256
DOMOPI_ACCESS_TOKEN_EXPIRE_MINUTES=60
DOMOPI_REFRESH_TOKEN_EXPIRE_DAYS=7
# Compte administrateur cree au premier demarrage
DOMOPI_ADMIN_USERNAME=admin
DOMOPI_ADMIN_PASSWORD=change-me

# --- HTTPS (optionnel, laisser vide pour HTTP) ---
DOMOPI_SSL_CERTFILE=
DOMOPI_SSL_KEYFILE=

# --- Base de donnees ---
DOMOPI_DATABASE_URL=sqlite:///data/domopi.db

# --- Journalisation ---
DOMOPI_LOG_DIR=logs
DOMOPI_LOG_LEVEL=INFO
DOMOPI_LOG_MAX_BYTES=5242880          # 5 Mo par fichier
DOMOPI_LOG_BACKUP_COUNT=5

# --- Radiofrequence ---
# Pilote : mock | rf433 | somfy_rts
DOMOPI_RF_DRIVER=mock
DOMOPI_RF_TX_GPIO=17                  # GPIO emetteur 433 MHz
DOMOPI_RF_RX_GPIO=27                  # GPIO recepteur 433 MHz (apprentissage)
DOMOPI_RF_REPEATS=8                   # Nombre de repetitions d'une trame

# --- Philips Hue ---
DOMOPI_HUE_ENABLED=true
DOMOPI_HUE_BRIDGE_IP=                 # vide = decouverte automatique
DOMOPI_HUE_APP_KEY=                   # vide = appairage requis (bouton du pont)

# --- Matter ---
DOMOPI_MATTER_ENABLED=true
DOMOPI_MATTER_SERVER_URL=ws://127.0.0.1:5580/ws

# --- HomeKit ---
DOMOPI_HOMEKIT_ENABLED=true
DOMOPI_HOMEKIT_BRIDGE_NAME=DomoPi Bridge
DOMOPI_HOMEKIT_PORT=51826
DOMOPI_HOMEKIT_PINCODE=031-45-154
DOMOPI_HOMEKIT_STATE_FILE=data/homekit.state
