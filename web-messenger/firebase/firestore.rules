rules_version = '2';

// Règles de sécurité Firestore pour DuoChat.
// Principes :
//   - Tout accès exige une authentification.
//   - Un utilisateur ne peut écrire que son propre document `users`.
//   - Conversations et messages ne sont accessibles qu'aux 2 participants.
//   - L'email doit être vérifié pour participer aux conversations.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // -------- Utilisateurs --------
    match /users/{userId} {
      // Lecture autorisée à tout utilisateur connecté (pour afficher le contact).
      allow read: if isSignedIn();

      // Création : uniquement son propre document, avec l'email du compte.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email;

      // Mise à jour : uniquement son propre document.
      allow update: if isSignedIn() && request.auth.uid == userId;

      // Pas de suppression côté client.
      allow delete: if false;
    }

    // -------- Conversations --------
    match /conversations/{conversationId} {

      allow read: if isVerified()
                  && request.auth.uid in resource.data.participants;

      allow create: if isVerified()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      allow update: if isVerified()
                    && request.auth.uid in resource.data.participants;

      allow delete: if false;

      // -------- Messages --------
      match /messages/{messageId} {

        function convParticipants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow read: if isVerified() && request.auth.uid in convParticipants();

        // L'expéditeur doit être l'utilisateur courant et un participant.
        allow create: if isVerified()
                      && request.auth.uid in convParticipants()
                      && request.resource.data.senderId == request.auth.uid;

        // Mise à jour réservée aux participants (ex : passage au statut "lu").
        allow update: if isVerified() && request.auth.uid in convParticipants();

        allow delete: if false;
      }
    }
  }
}
