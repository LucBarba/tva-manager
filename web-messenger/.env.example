# Configuration Firebase (Console Firebase → Paramètres du projet → Vos applications → Web)
# Copiez ce fichier en `.env` puis renseignez vos valeurs.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# Clé publique VAPID pour les notifications Web Push (Console Firebase →
# Cloud Messaging → Configuration Web → Certificats push Web)
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key
